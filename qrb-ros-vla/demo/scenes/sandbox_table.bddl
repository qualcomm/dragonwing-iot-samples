(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Free play sandbox with one black bowl and one plate)
    (:regions
      (bowl_region
          (:target main_table)
          (:ranges (
              (-0.06 0.09 -0.04 0.11)
            )
          )
      )
      (plate_region
          (:target main_table)
          (:ranges (
              (0.05 0.19 0.07 0.21)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_bowl_region)
    (On plate_1 main_table_plate_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )

)
